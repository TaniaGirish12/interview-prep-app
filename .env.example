# Copy to .env and fill in.

# Which model backend to use:
#   claude-code  runs the `claude` CLI on your Claude subscription login (no API key needed)
#   api          calls the Anthropic API with ANTHROPIC_API_KEY (billed per token)
LLM_BACKEND=claude-code
ANTHROPIC_MODEL=claude-sonnet-5-5

# claude-code backend: path to the CLI if `claude` is not on your PATH.
# CLAUDE_CLI=/Users/you/.local/bin/claude

# api backend only. The key is read by the backend and never reaches the browser.
ANTHROPIC_API_KEY=
# Server-side refusal fallback (beta). Set to false to turn it off.
REFUSAL_FALLBACK=true

# How many top study-next topics (tier 1-2) to pre-generate in the background.
# Opening any topic still generates it on demand. 0 turns background generation off.
PREFETCH_TOPICS=5

# Optional overrides
# EFFORT_TOPIC=high
# TOPIC_WORKERS=2
# DB_PATH=backend/data/app.db
