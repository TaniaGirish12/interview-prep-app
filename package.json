{
  "name": "interview-prep-app",
  "private": true,
  "scripts": {
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd backend && python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'",
    "setup:frontend": "cd frontend && npm install",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .venv/bin/python -m pytest -q",
    "test:frontend": "cd frontend && npm test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
